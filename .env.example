# Copy to .env for Docker. For native startup, set these as environment variables.
RELAY_ORIGIN=http://localhost:8765
RELAY_TIMEZONE=Asia/Shanghai
# Keep unset for localhost. Set 1 behind an HTTPS reverse proxy.
RELAY_SECURE_COOKIE=0
# Optional bootstrap password (12+ chars). Otherwise create in the local UI.
RELAY_ADMIN_PASSWORD=
# Mount data persistently. Never publish data or its encryption key.
RELAY_DATA_DIR=./data
# Gmail: create your own Google Cloud OAuth Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Agent endpoint. HTTPS only; no default external provider.
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
